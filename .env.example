# Copy to .env and change every password. Use letters/digits only:
# these values are pasted into postgres:// URLs unescaped.
POSTGRES_USER=ezm_owner
POSTGRES_PASSWORD=change_me_owner
POSTGRES_DB=ezmonitor

EZM_INGEST_PASSWORD=change_me_ingest
EZM_API_PASSWORD=change_me_api
EZM_READONLY_PASSWORD=change_me_readonly

DB_PORT=5432
RETENTION_DAYS=30
EZM_DOMAIN=localhost
