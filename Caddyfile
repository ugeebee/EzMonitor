# Reverse proxy. Set EZM_DOMAIN in .env to a real domain for automatic HTTPS.
{$EZM_DOMAIN:localhost} {
	encode zstd gzip

	# API, agent ingest and the agent pairing WebSocket
	handle /api/* {
		reverse_proxy backend:8080
	}

	# React app (static build served by the frontend container)
	handle {
		reverse_proxy frontend:80
	}
}
