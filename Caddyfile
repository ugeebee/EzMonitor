# Reverse proxy. Set EZM_DOMAIN in .env to a real domain for automatic HTTPS.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /downloads/* {
		reverse_proxy backend:8080
	}

	handle /install.sh {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:5173 {
			header_up Host localhost:5173
		}
	}
}
