# Copy to .env.local for `npm run dev`.

# Leave empty to call the API on the same origin: the Vite dev server proxies
# /api to http://localhost:8080 (override with VITE_PROXY_TARGET), and in
# Docker Caddy serves the app and the API together.
VITE_API_URL=

# The read API (series, fleet, alerts) is now mounted in the Go server.
# Set true only to demo the UI without a backend.
VITE_MOCK_QUERY_API=false
# VITE_QUERY_PREFIX=
