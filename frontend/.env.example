# Copy to .env.local and set to wherever the Go backend is listening
VITE_API_URL=http://localhost:8080

# Divesh's read API (series, fleet, alerts) is not wired into the Go server yet.
# true = show synthetic demo data in its documented shape. Remove or set false once merged.
VITE_MOCK_QUERY_API=true
